# Dependencies
node_modules/

# Build output
/dist
/build
/.next
/out
/.cache

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Environment variables
.env
.env.*
!.env.example

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# TypeScript cache
*.tsbuildinfo

# NestJS / compiled artifacts
# Keep generated Prisma / database files if you do not want them committed
# prisma/dev.db
# prisma/dev.db-journal

# Test results
test-results/
playwright-report/

# Temporary files
tmp/
temp/
*.tmp

# Optional: local package manager caches
.pnpm-store/
.npm/
.yarn/
.yarn-cache/

# Optional: if using webpack / parcel / vite
.parcel-cache/
.vite/

# Optional: lockfile exceptions (uncomment if you intentionally keep a lockfile in repo)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
